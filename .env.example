# Copiar para .env. Preencher secrets locais aleatórios; nunca versionar .env.
POSTGRES_DB=govintel_db
POSTGRES_USER=govintel_user
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=govintel
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=govintel
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/${RABBITMQ_DEFAULT_VHOST}
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
FRONTEND_ORIGIN=http://localhost:3000
# Origens adicionais separadas por vírgula; no desenvolvimento local, aceite os dois hosts.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# LLM e embeddings têm configuração independente. `mock` é exclusivo de testes/demo.
LLM_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_MODEL=deepseek-v4-flash

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
LOCAL_EMBEDDING_DIMENSIONS=768
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_REVISION=main
# Cache local compartilhável entre api/worker; não contém PDFs nem secrets.
LOCAL_EMBEDDING_CACHE_DIR=/var/lib/govintel/huggingface

# Providers legados permanecem disponíveis somente por seleção explícita.
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_LLM_MODEL=xiaomi/mimo-v2.5
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
UPLOAD_RETENTION_DAYS=30
# OCR de PDFs escaneados (Tesseract + pacote por); desative com OCR_ENABLED=false.
OCR_ENABLED=true
OCR_LANGUAGE=por
