    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "27.4.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "vitest": "4.1.11"
  },
